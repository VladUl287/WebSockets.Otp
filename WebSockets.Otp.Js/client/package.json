{
  "name": "websockets.otp.js",
  "version": "1.0.6",
  "description": "Tiny WebSocket client",
  "type": "module",
  "keywords": [
    "websocket",
    "websockets",
    "repr",
    "real-time",
    "realtime",
    "ws"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/VladUl287/WebSoket.Otp/tree/main/WebSockets.Otp.Js"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./pending": {
      "types": "./dist/pending.d.ts",
      "import": "./dist/pending.js",
      "default": "./dist/pending.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@fefruess/websockets.otp.json": "^0.0.5"
  }
}
